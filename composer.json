{
    "name": "company/seo-tool",
    "description": "Web quản lý dự án SEO: viết bài AI, interlink, đăng WordPress, đồng bộ Google Sheet",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "anthropic-ai/sdk": "^0.54",
        "guzzlehttp/guzzle": "^7.8"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.1.0"
        }
    }
}
